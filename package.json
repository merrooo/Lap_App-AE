{
  "name": "Lab App",
  "version": "1.0.0",
  "description": "منصة أدوات فحص وتكهين وحسابات العدادات والقدرة",
  "main": "index.html",
  "scripts": {
    "build": "echo 'No web compilation needed'",
    "ionic:build": "npm run build",
    "cap": "node ./node_modules/@capacitor/cli/bin/capacitor",
    "sync": "node ./node_modules/@capacitor/cli/bin/capacitor sync",
    "sync:android": "node ./node_modules/@capacitor/cli/bin/capacitor sync android",
    "postinstall": "node ./node_modules/@capacitor/cli/bin/capacitor sync android"
  },
  "dependencies": {
    "@capacitor/android": "^6.0.0",
    "@capacitor/cli": "^6.2.1",
    "@capacitor/core": "^6.0.0",
    "@capacitor/ios": "^6.0.0"
  }
}
